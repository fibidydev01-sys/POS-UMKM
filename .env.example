# Salin file ini menjadi .env.local lalu isi kredensial Supabase Anda.
# (Settings → API di dashboard Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # ← isi ini, jangan dikosongkan

# Versi POS — v3 = superset v2 + QRIS
NEXT_PUBLIC_POS_VERSION=v3

# Enkripsi kredensial PG (SERVER ONLY — JANGAN pakai prefix NEXT_PUBLIC_)
PG_ENCRYPTION_KEY=                 # ← generate dulu, lihat di bawah

#node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"